{
	admin off
	# 裸 IP 部署时由 .env 传 local_certs，改用 Caddy 内置 CA 自签（公信 CA 不给裸 IP 签证书）。
	# 域名部署留空即走 ACME；空展开后被当作空行，Caddy 允许。
	{$CADDY_LOCAL_CERTS}
	email {$ACME_EMAIL:ops@example.com}
}

# 站点路由在 http / https 两个入口间共享：两个入口都能独立访问，不再互相跳转。
(site) {
	# 媒体走 RustFS 已是压缩格式，避免对视频/图片做二次压缩。
	@compressible not path /{$S3_BUCKET:storage}/*
	encode @compressible zstd gzip

	# 只接受 100MB 以内的请求体；与 UPLOAD_MAX_BYTES 保持一致。
	request_body {
		max_size 100MB
	}

	# 访问日志默认关闭：GET /api/sso/jwt 的 token 在查询串中，
	# 避免 Caddy 访问日志记录 token；后端 Uvicorn 访问日志已做脱敏。
	# 需要访问日志时请先确认 SSO 只走 POST，或接入可脱敏的日志管道。

	handle /api/* {
		reverse_proxy backend:8000
	}

	# 不重写路径：/<bucket>/<key> 原样转给 RustFS（path-style），保证 SigV4 canonical URI 一致。
	# bucket 名由 S3_BUCKET 提供，与后端 presign 及 /v1/site 的 storage_prefix 一致。
	handle /{$S3_BUCKET:storage}/* {
		reverse_proxy rustfs:9000
	}

	# 静态资源缺失返回 404，不落到 SPA fallback。
	handle /assets/* {
		root * /srv
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

# 站点地址由 deploy/.env 的 SITE_ADDRESS 提供（域名或裸 IP，不带 scheme / 端口）。
# 本地无域名时用 localhost。写全 scheme 是为了关掉 Caddy 自动的 http → https 跳转，
# 让两个入口都能直接使用。
http://{$SITE_ADDRESS:localhost} {
	import site
}

https://{$SITE_ADDRESS:localhost} {
	import site
}
