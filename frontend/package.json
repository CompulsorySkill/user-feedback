{
  "name": "frontend",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings src tests",
    "format": "oxfmt src tests index.html vite.config.ts vitest.config.ts package.json",
    "format:check": "oxfmt --check src tests index.html vite.config.ts vitest.config.ts package.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.49.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
