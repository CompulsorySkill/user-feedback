{
  "name": "frontend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings src tests",
    "format": "oxfmt src tests index.html vite.config.ts vitest.config.ts package.json",
    "format:check": "oxfmt --check src tests index.html vite.config.ts vitest.config.ts package.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@tabler/icons-vue": "^3.49.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.1",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.9.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@devframes/plugin-terminals--assets": "1.3.2",
    "@types/node": "^24.19.2",
    "@vitejs/devtools": "^0.8.1",
    "@vitejs/devtools-oxc": "^0.8.1",
    "@vitejs/devtools-vite": "^0.8.1",
    "@vitejs/devtools-vitest": "^0.8.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-tailwind-compat": "^0.1.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
