{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["vue"],
  "categories": {
    "correctness": "deny",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**"],
  "rules": {
    "eslint/no-underscore-dangle": ["warn", { "allow": ["__FEEDLOG_BASE__"] }]
  }
}
