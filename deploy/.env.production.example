# 生产环境配置模板（复制为 deploy/.env）
# ENVIRONMENT=production 时，后端启动会校验：Postgres URL、SSO_SECRETS、
# SESSION_JWT_SECRET、RustFS 三个必填项；不满足直接拒绝启动。

ENVIRONMENT=production

# 网站名称（前端品牌与浏览器标题）
APP_NAME=FeedLog

# Postgres：Compose 中 backend 会用 POSTGRES_PASSWORD 重新拼出连接串；
# 非 Compose 部署时请把这里改成实际连接串。
DATABASE_URL=postgresql+asyncpg://feedback:CHANGE_ME_STRONG_PASSWORD@postgres:5432/feedback
# 会拼进 backend 的 DATABASE_URL，请使用 URL 安全字符（或百分号编码）。
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Caddy 站点地址：生产填域名（自动申请 HTTPS），本地 HTTP 可填 :80。
SITE_ADDRESS=feedback.example.com
ACME_EMAIL=ops@example.com

# 站点同源地址（CORS 与 cookie 域），必须与 https://SITE_ADDRESS 一致。
PUBLIC_ORIGIN=https://feedback.example.com

SQL_ECHO=false

# SSO：64 位 hex 字符串数组，新的放前面；轮换流程见 docs/sso.md
SSO_SECRETS=["CHANGE_ME_64_HEX"]
SSO_RETURN_TO_DEFAULT=/

# 本系统会话密钥（与 SSO 分离，建议 64 位随机）
SESSION_JWT_SECRET=CHANGE_ME_RANDOM_64_HEX

# 管理员邮箱，逗号分隔；改完必须重启 backend
ADMIN_EMAILS=alice@example.com,bob@example.com

# 对象存储：浏览器与签名使用的公网同域地址
RUSTFS_ENDPOINT_INTERNAL=http://rustfs:9000
RUSTFS_ENDPOINT_PUBLIC=https://feedback.example.com
RUSTFS_BUCKET=storage
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME

# 可选：使用 GHCR 镜像部署时设置；不设置则在本机 docker compose build。
# 生产建议固定 semver tag（v* tag 构建会自动生成），不要用 latest。
# BACKEND_IMAGE=ghcr.io/your-org/your-repo/backend:1.0.0
# FRONTEND_IMAGE=ghcr.io/your-org/your-repo/frontend:1.0.0
# 生产建议固定 RustFS 具体版本 tag，而不是 latest。
# RUSTFS_IMAGE=rustfs/rustfs:latest

UPLOAD_MAX_BYTES=104857600
# 上传对象保留时长：超过该小时数且未被反馈/更新日志引用的对象由清理任务删除。
UPLOAD_CLEANUP_GRACE_HOURS=24
RATE_LIMIT_ENABLED=true

# 会话有效期（可选，默认 15 分钟 / 7 天）
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
