# 唯一配置来源：本地开发与 Docker Compose 共用本文件（复制为 deploy/.env 后填写）。
# 后端通过 pydantic-settings 的 env_file 指向本目录，不存在 backend/.env。

# 运行环境：development / production。
ENVIRONMENT=development

# 网站名称：前端头部与浏览器标题统一读取此值。
APP_NAME=FeedLog

# 数据库：本地默认 SQLite；生产使用 postgres（Compose 中由 postgres 服务拼出）。
DATABASE_URL=sqlite+aiosqlite:///./feedback.db

# 对外站点地址（CORS 与 cookie 域）。
PUBLIC_ORIGIN=http://localhost:5173

# cookie 的 Secure 标记：留空按 ENVIRONMENT 推断（生产开、开发关）。
# 需要用 http 直接访问并登录时设为 false。
COOKIE_SECURE=

# SQL 回显（调试用）。
SQL_ECHO=false

# Caddy 证书来源：留空走 ACME（域名）；裸 IP HTTPS 时设 local_certs 用内置 CA 自签。
CADDY_LOCAL_CERTS=

# Caddy 暴露的宿主机端口（容器内固定 80/443）；改端口后 PUBLIC_ORIGIN 要带上端口。
# http 与 https 两个入口同时可用，不再互相跳转。
HTTP_PORT=80
HTTPS_PORT=443

# --- 以下为 P3 起启用的鉴权配置；production 环境启动时会强制校验非空 ---

# HS256 密钥数组（JSON 字符串，可滚动轮换，第一个为当前签发密钥）。
SSO_SECRETS=[""]

# SSO 回调缺省落地路径（仅站内相对路径）。
SSO_RETURN_TO_DEFAULT=/

# 本系统会话 JWT 密钥（与 SSO 密钥分离）。
SESSION_JWT_SECRET=

# 管理员邮箱（逗号分隔，登录时同步 role）。
ADMIN_EMAILS=

# 管理员密码：与 ADMIN_EMAILS 搭配，开发与生产都可在 /login 用「邮箱 + 密码」进入管理员后台。
# 留空则关闭该入口；改完必须重启 backend。
ADMIN_PASSWORD=

# --- 对象存储（P2 起启用）---
# 上传 presign 用 PUBLIC_ORIGIN，这里只需后端访问的内网地址。
S3_ENDPOINT_INTERNAL=http://rustfs:9000
S3_BUCKET=storage
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 单文件上传上限，默认 100MB。
UPLOAD_MAX_BYTES=104857600
# 未引用上传对象保留时长（小时），供 scripts.cleanup_uploads 使用。
UPLOAD_CLEANUP_GRACE_HOURS=24

# 限流开关。
RATE_LIMIT_ENABLED=true
