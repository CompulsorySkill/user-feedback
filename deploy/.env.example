# 唯一配置来源：复制为 deploy/.env（不存在 backend/.env）。
# 模板值面向生产部署；本地开发按 README「本地开发 → 1. 配置」改
# ENVIRONMENT / DATABASE_URL / PUBLIC_ORIGIN 三行即可。
# 变量含义、三种入口场景的取值与部署步骤见 docs/deploy.md。

# --- 全局 ---
ENVIRONMENT=production
APP_NAME=FeedLog
# 必须与浏览器实际访问的协议 + 主机 + 端口完全一致。
PUBLIC_ORIGIN=https://feedback.example.com
# 留空按 ENVIRONMENT 推断；明文 HTTP 访问需设 false。
COOKIE_SECURE=
SQL_ECHO=false

# --- backend：数据库与鉴权 ---
DATABASE_URL=postgresql+asyncpg://feedback:CHANGE_ME_STRONG_PASSWORD@postgres:5432/feedback
SSO_SECRETS=["CHANGE_ME_64_HEX"]
SSO_RETURN_TO_DEFAULT=/
SESSION_JWT_SECRET=CHANGE_ME_RANDOM_64_HEX
ADMIN_EMAILS=alice@example.com,bob@example.com
ADMIN_PASSWORD=

# --- backend：对象存储与上传（S3_ACCESS_KEY / S3_SECRET_KEY 也会传给 rustfs 服务）---
S3_ENDPOINT_INTERNAL=http://rustfs:9000
S3_BUCKET=storage
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
UPLOAD_MAX_BYTES=104857600
UPLOAD_CLEANUP_GRACE_HOURS=24
RATE_LIMIT_ENABLED=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- postgres ---
# 需与 DATABASE_URL 里的密码一致；Compose 用它重拼 backend 的连接串。
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- frontend（Caddy）---
# 域名或裸 IP，不带 scheme / 端口；两个入口同时可用。
SITE_ADDRESS=feedback.example.com
ACME_EMAIL=ops@example.com
CADDY_LOCAL_CERTS=
HTTP_PORT=80
HTTPS_PORT=443

# --- compose 镜像覆盖（可选；留空则本机构建）---
# 生产建议固定 semver tag。
# BACKEND_IMAGE=ghcr.io/your-org/your-repo/backend:1.0.5
# FRONTEND_IMAGE=ghcr.io/your-org/your-repo/frontend:1.0.5
# S3_IMAGE=rustfs/rustfs:latest
